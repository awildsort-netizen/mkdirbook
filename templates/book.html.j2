{#- book.html.j2 — Standalone HTML output via Jinja2                         -#}
{#- Uses ch.content_html as pre-rendered HTML                               -#}
{#- Each role has its own macro; override by copy-editing this file.          -#}

{%- macro render_chapter(ch) -%}
<section id="{{ ch.anchor_id }}" class="chapter" data-role="chapter">
{% if ch.num is not none %}<p class="chapter-label">Chapter {{ ch.num }}</p>{% endif %}
{{ ch.content_html | safe }}
</section>
{%- endmacro -%}

{%- macro render_introduction(ch) -%}
<section id="{{ ch.anchor_id }}" class="introduction" data-role="introduction">
<p class="role-label">Introduction</p>
{{ ch.content_html | safe }}
</section>
{%- endmacro -%}

{%- macro render_prologue(ch) -%}
<section id="{{ ch.anchor_id }}" class="prologue" data-role="prologue">
<p class="role-label">Prologue</p>
{{ ch.content_html | safe }}
</section>
{%- endmacro -%}

{%- macro render_epilogue(ch) -%}
<section id="{{ ch.anchor_id }}" class="epilogue" data-role="epilogue">
<p class="role-label">Epilogue</p>
{{ ch.content_html | safe }}
</section>
{%- endmacro -%}

{%- macro render_appendix(ch) -%}
<section id="{{ ch.anchor_id }}" class="appendix" data-role="appendix">
<p class="role-label">Appendix</p>
{{ ch.content_html | safe }}
</section>
{%- endmacro -%}

{%- macro render_default(ch) -%}
<section id="{{ ch.anchor_id }}" data-role="{{ ch.role }}">
{{ ch.content_html | safe }}
</section>
{%- endmacro -%}

{%- macro render(ch) -%}
{%- if ch.role == "chapter" %}{{ render_chapter(ch) -}}
{%- elif ch.role == "introduction" %}{{ render_introduction(ch) -}}
{%- elif ch.role == "prologue" %}{{ render_prologue(ch) -}}
{%- elif ch.role == "epilogue" %}{{ render_epilogue(ch) -}}
{%- elif ch.role == "appendix" %}{{ render_appendix(ch) -}}
{%- else %}{{ render_default(ch) -}}
{%- endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --text: #222; --muted: #888; --rule: #ddd; --accent: #c00; }
  body { font-family: Georgia, serif; max-width: 680px; margin: 3em auto; padding: 0 1.5em; line-height: 1.75; color: var(--text); }
  h1,h2,h3,h4 { font-family: system-ui, sans-serif; }
  h1 { font-size: 2.2em; border-bottom: 2px solid var(--rule); padding-bottom: 0.4em; }
  h2 { font-size: 1.5em; margin-top: 2.5em; }
  h3 { font-size: 1.2em; }
  hr { border: none; border-top: 1px solid var(--rule); margin: 3em 0; }
  blockquote { border-left: 3px solid var(--rule); margin: 1.2em 0; padding: 0.2em 1.2em; color: #555; }
  pre { background: #f5f5f5; padding: 1em; overflow-x: auto; font-size: 0.9em; }
  code { font-family: monospace; font-size: 0.92em; }
  a { color: var(--accent); }
  .cover { text-align: center; margin: 4em 0 5em; }
  .cover h1 { font-size: 3em; border: none; }
  .cover .subtitle { color: var(--muted); font-style: italic; margin-top: 0.5em; }
  .chapter-label, .role-label {
    font-family: system-ui, sans-serif; font-size: 0.8em; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted);
    margin-bottom: 0.3em;
  }
  .toc { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 1.5em 0; margin: 0 0 3em; }
  .toc h2 { margin-top: 0; margin-bottom: 0.8em; }
  .toc ol { margin: 0; padding-left: 1.4em; }
  .toc li + li { margin-top: 0.35em; }
  .toc .toc-role { color: var(--muted); font-size: 0.92em; }
  section.chapter { margin-bottom: 3em; }
  section.introduction { font-style: italic; margin-bottom: 3em; }
  section.prologue { margin-bottom: 3em; }
  section.epilogue { border-top: 1px solid var(--rule); padding-top: 2em; margin-top: 3em; }
  section.appendix { border-top: 1px dashed var(--rule); padding-top: 1.5em; font-size: 0.95em; }
  .arithmatex { overflow-x: auto; }
</style>
<script>
window.MathJax = {
  tex: {
    inlineMath: [["\\(", "\\)"]],
    displayMath: [["\\[", "\\]"]],
    processEscapes: true,
    processEnvironments: true
  },
  options: {
    skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"]
  }
};
</script>
<script id="MathJax-script" async
        src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
</head>
<body>
<div class="cover">
  <h1>{{ title }}</h1>
  <div class="subtitle">{{ date }}</div>
</div>
{% if chapters %}
<nav class="toc" aria-labelledby="table-of-contents-title">
  <h2 id="table-of-contents-title">Table of Contents</h2>
  <ol>
  {% for ch in chapters %}
    <li class="toc-{{ ch.role }}"><a href="#{{ ch.anchor_id }}">{{ ch.title }}</a>{% if ch.toc_prefix %} <span class="toc-role">{{ ch.toc_prefix }}</span>{% endif %}</li>
  {% endfor %}
  </ol>
</nav>
{% endif %}
{% for ch in chapters %}
{{ render(ch) }}
{% if not loop.last %}<hr>{% endif %}
{% endfor %}
</body>
</html>
